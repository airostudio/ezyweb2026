# ── Core ──────────────────────────────────────────────────────────────
# Public URL of this deployment (used for metadata, OG images, magic links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Auth (NextAuth v5) ────────────────────────────────────────────────
# REQUIRED in production. Generate with: npx auth secret  (or: openssl rand -base64 32)
# Optional locally — a dev-only fallback is used when unset.
AUTH_SECRET=
# Optional social providers. Buttons only appear when both values are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
# Magic-link email delivery via Resend. In development, links are shown on
# screen instead. The FROM address must use a domain verified in Resend
# (Resend → Domains); until then use "aduma.io <onboarding@resend.dev>",
# which only delivers to your own Resend account email.
RESEND_API_KEY=
AUTH_EMAIL_FROM="aduma.io <hello@aduma.io>"

# ── AI site builder ──────────────────────────────────────────────────
# Every plan uses the same model: DeepSeek V4.1 Flash, served by Fireworks.
# Without FIREWORKS_API_KEY the free built-in mock generator is used.
FIREWORKS_API_KEY=
# Optional: full Fireworks model path, or a bare name (expanded to
# accounts/fireworks/models/<name>).
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4p1-flash-1017
# Output token cap per build, reasoning included (default 32000).
FIREWORKS_MAX_TOKENS=
FIREWORKS_BASE_URL=
# Set to "mock" to force the mock generator even with a key present.
AI_PROVIDER=
# Optional: proxy to a hosted aduma.io engine that speaks the NDJSON protocol
ADUMA_API_URL=
ADUMA_API_KEY=

# ── Plans & budget guards ────────────────────────────────────────────
# Quota counters (builds/day, edits/site). Strongly recommended before using a
# paid model in production — without it, counts are per server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Manual plan grants (comps/testing), checked before Stripe: "a@b.com:pro,c@d.com:bottomless"
PLAN_OVERRIDES=

# ── Payments (Stripe) ────────────────────────────────────────────────
# Secret key from https://dashboard.stripe.com/apikeys (sk_test_… while testing).
# Without it, upgrade buttons explain that payments aren't switched on yet.
STRIPE_SECRET_KEY=
# Optional: use Prices from your Stripe dashboard instead of the built-in
# AUD amounts (Pro $8/mo or $72/yr, Bottomless $12/mo or $108/yr).
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BOTTOMLESS_MONTHLY=
STRIPE_PRICE_BOTTOMLESS_YEARLY=

# ── Drafts (optional) ────────────────────────────────────────────────
# Without these, drafts live in localStorage only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Analytics (optional, pick one) ───────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
