# ── Core ──────────────────────────────────────────────────────────────
# Public URL of this deployment (used for metadata, OG images, magic links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Auth (NextAuth v5) ────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Optional social providers. Buttons only appear when both values are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
# Magic-link email delivery via Resend. If unset, links are logged to the
# server console (and shown on screen in development) instead.
RESEND_API_KEY=
AUTH_EMAIL_FROM="Webese <hello@webese.ai>"

# ── Generation backend ───────────────────────────────────────────────
# Leave empty to use the built-in mock generator. Set both to proxy to the
# real webese.ai API (see README → "Swapping the mock for webese.ai").
WEBESE_API_URL=
WEBESE_API_KEY=

# ── Drafts (optional) ────────────────────────────────────────────────
# Without these, drafts live in localStorage only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Analytics (optional, pick one) ───────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
